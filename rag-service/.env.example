# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=5000
NODE_ENV=development

# MongoDB Atlas (must support Vector Search - free M0 tier works)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baby-care-rag

# Auth (used only so /assistant/ask can be tested against a real baby+parent)
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:3000

# Google AI (Gemini) - https://aistudio.google.com -> "Get API key"
# NOTE: keys created from mid-2026 onward are "Auth Keys" (start with AQ.)
# and must be sent via an x-goog-api-key header, not a ?key= URL param.
# This project's rag/googleAiClient.js already does this correctly.
GOOGLE_AI_API_KEY=replace_this_with_your_google_ai_key
